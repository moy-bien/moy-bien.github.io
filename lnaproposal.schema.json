{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/lnaproposal.schema.json",
  "title": "Learning Proposal Intake",
  "type": "object",
  "required": ["project", "client", "audience", "business", "constraints", "strategy"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "sponsor", "primary_contact"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "sponsor": { "type": "string" },
        "primary_contact": { "type": "string" },
        "background": { "type": "string" },
        "problem_statement": { "type": "string" },
        "success_criteria": { "type": "string", "description": "Acceptance criteria for sign-off" },
        "timeline": {
          "type": "object",
          "properties": {
            "target_launch_date": { "type": "string", "format": "date" },
            "milestones": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "client": {
      "type": "object",
      "required": ["organization", "industry", "stakeholders"],
      "properties": {
        "organization": { "type": "string" },
        "industry": { "type": "string" },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "responsibilities"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "responsibilities": { "type": "string" },
              "influence": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "required": ["segments", "size"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "persona", "geos"],
            "properties": {
              "label": { "type": "string" },
              "persona": { "type": "string", "enum": ["IC", "Manager", "Leader", "Mixed"] },
              "experience_level": { "type": "string", "enum": ["novice", "intermediate", "advanced", "mixed"] },
              "geos": { "type": "array", "items": { "type": "string" } },
              "languages": { "type": "array", "items": { "type": "string" } },
              "access_needs": { "type": "array", "items": { "type": "string" } },
              "tech_env": { "type": "array", "items": { "type": "string" }, "description": "Devices/browsers/apps" }
            }
          }
        }
      }
    },
    "business": {
      "type": "object",
      "required": ["goals", "kpis"],
      "properties": {
        "goals": { "type": "array", "items": { "type": "string" } },
        "kpis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "baseline"],
            "properties": {
              "name": { "type": "string" },
              "baseline": { "type": "number" },
              "target": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "root_causes": { "type": "array", "items": { "type": "string" } },
        "non_training_factors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["budget", "timebox", "resources", "policies"],
      "properties": {
        "budget": {
          "type": "object",
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "amount": { "type": "number", "minimum": 0 }
          }
        },
        "timebox": { "type": "string", "description": "e.g., 6 weeks, Q1 only" },
        "resources": {
          "type": "array",
          "items": { "type": "string", "description": "Available SMEs, tools, content" }
        },
        "policies": {
          "type": "array",
          "items": { "type": "string", "description": "Compliance, accessibility, data" }
        },
        "content_rights": { "type": "string", "enum": ["client_owns", "shared", "vendor_owns"] }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["delivery", "engagement", "analytics"],
      "properties": {
        "delivery": {
          "type": "array",
          "items": { "type": "string", "enum": ["ILT", "VILT", "eLearning", "Microlearning", "Blended", "Cohort", "Coaching"] }
        },
        "engagement": {
          "type": "array",
          "items": { "type": "string", "description": "Simulations, scenarios, gamification, discussion prompts" }
        },
        "analytics": {
          "type": "object",
          "properties": {
            "standards": { "type": "array", "items": { "type": "string", "enum": ["SCORM", "xAPI", "LTI", "None"] } },
            "dashboards": { "type": "array", "items": { "type": "string" } },
            "privacy": { "type": "string" }
          }
        }
      }
    },
    "curriculum": {
      "type": "object",
      "required": ["learning_objectives", "modules"],
      "properties": {
        "learning_objectives": {
          "type": "array",
          "items": { "type": "string", "description": "Bloom-aligned objectives" },
          "minItems": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "outcomes"],
            "properties": {
              "title": { "type": "string" },
              "duration_minutes": { "type": "integer", "minimum": 5 },
              "outcomes": { "type": "array", "items": { "type": "string" } },
              "content_types": { "type": "array", "items": { "type": "string" } },
              "assessments": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["work_breakdown", "risks"],
      "properties": {
        "work_breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task", "owner", "start", "end"],
            "properties": {
              "task": { "type": "string" },
              "owner": { "type": "string" },
              "start": { "type": "string", "format": "date" },
              "end": { "type": "string", "format": "date" },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "racis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["deliverable", "R", "A", "C", "I"],
            "properties": {
              "deliverable": { "type": "string" },
              "R": { "type": "string" },
              "A": { "type": "string" },
              "C": { "type": "array", "items": { "type": "string" } },
              "I": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk", "likelihood", "impact", "mitigation"],
            "properties": {
              "risk": { "type": "string" },
              "likelihood": { "type": "string", "enum": ["low", "medium", "high"] },
              "impact": { "type": "string", "enum": ["low", "medium", "high"] },
              "mitigation": { "type": "string" }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "existing_assets": { "type": "array", "items": { "type": "string" } },
        "additional_references": { "type": "array", "items": { "type": "string" } },
        "tools_stack": { "type": "array", "items": { "type": "string" } }
      }
    },
    "legal": {
      "type": "object",
      "properties": {
        "nda_required": { "type": "boolean" },
        "data_processing_addendum": { "type": "boolean" },
        "ip_notes": { "type": "string" }
      }
    },
    "ai_summaries": {
      "type": "object",
      "properties": {
        "business_context": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "object",
              "properties": {
                "background": { "type": "string" },
                "problem_statement": { "type": "string" }
              }
            },
            "draft": { "type": "string" },
            "status": { "type": "string", "enum": ["pending_synthesis", "awaiting_review", "changes_requested", "approved"] },
            "approver": { "type": "string" },
            "notes": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["inputs", "status"]
        }
      }
    }
  }
}
